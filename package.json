{
  "name": "tiny-jwt-decode",
  "version": "1.0.0",
  "description": "A zero-dependency, ~500-byte JWT decoder for the browser and Node — decodes header/payload, checks expiry, no signature verification included.",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "keywords": ["jwt", "jwt-decode", "json-web-token", "decode", "zero-dependency", "typescript"],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ahsan-techs/tiny-jwt-decode.git"
  },
  "homepage": "https://github.com/ahsan-techs/tiny-jwt-decode#readme",
  "bugs": {
    "url": "https://github.com/ahsan-techs/tiny-jwt-decode/issues"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "tsx": "^4.7.0",
    "@types/node": "^20.11.0"
  },
  "sideEffects": false
}
